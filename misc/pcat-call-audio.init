#!/bin/sh /etc/rc.common
# OpenWrt init script for the pcat-call-audio daemon.
#
# Install to /etc/init.d/pcat-call-audio, then:
#   /etc/init.d/pcat-call-audio enable
#   /etc/init.d/pcat-call-audio start
#
# Starts after the web app (which generates the TLS cert with px5g and the
# shared token secret on first run). If either is missing the daemon exits
# immediately and the phone page falls back to the Python audio bridge, so a
# failure here degrades rather than breaks calls.

START=96
STOP=10
USE_PROCD=1

PROG=/usr/share/pcat-manager-web/pcat-call-audio
CERT=/etc/pcat-manager-web/ssl/cert.pem
KEY=/etc/pcat-manager-web/ssl/key.pem
SECRET=/etc/pcat-manager-web/audio_token.key

start_service() {
    [ -x "$PROG" ] || {
        logger -t pcat-call-audio "binary missing at $PROG, not starting"
        return 0
    }
    [ -f "$CERT" ] && [ -f "$KEY" ] || {
        logger -t pcat-call-audio "no TLS cert yet, not starting"
        return 0
    }
    [ -f "$SECRET" ] || {
        logger -t pcat-call-audio "no token secret yet (web app creates it), not starting"
        return 0
    }

    procd_open_instance
    procd_set_param command "$PROG" \
        --port 9444 --cert "$CERT" --key "$KEY" --secret "$SECRET"
    # Restart on crash, but back off so a persistent failure (no ALSA card,
    # bad cert) does not spin.
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "pcat-manager-web"
}
